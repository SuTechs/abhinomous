# Copy this file to .env and fill in both values.
# Supabase dashboard → Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (starts with sb_publishable_). It is safe in the browser —
# Row Level Security decides what it can do.
# Never put the SECRET key (sb_secret_…) or service_role key here:
# everything in this file ends up in the public JavaScript.
VITE_SUPABASE_PUBLISHABLE_KEY=
